#!/bin/bash
# codesign, retried when Apple's timestamp server does not answer.
#
# A Developer ID build asks that server for a timestamp on every signature, and after a burst of
# requests it sometimes answers nothing for a while: codesign fails with "A timestamp was expected
# but was not found". electron-builder's own retry starts the whole signing pass over, which only
# sends more requests into the same pause and failed four times running. Retrying the one file
# after a growing wait gets through. build/build-darwin.js puts this directory first on PATH for
# Developer ID builds; @electron/osx-sign calls `codesign` by name and lands here.

err="$(mktemp)"
trap 'rm -f "$err"' EXIT

for delay in 5 20 60 0; do
    /usr/bin/codesign "$@" 2>"$err"
    status=$?
    if [ "$status" = 0 ]; then
        cat "$err" >&2
        exit 0
    fi
    if [ "$delay" = 0 ] || ! grep -q "A timestamp was expected but was not found" "$err"; then
        cat "$err" >&2
        exit "$status"
    fi
    echo "  • no timestamp from Apple, signing again in ${delay}s" >&2
    sleep "$delay"
done
